      "shell": [
        "mkdir config api src src\\utils src\\agents src\\payroll web web\\src app app\\mobile scripts scripts\\windows docs"
      ]
    },
    {
      "name": "Write environment",
      "files": [
        {
          "path": ".env.example",
          "action": "write",
          "contents_ref": "env_example"
        },
        {
          "path": "config\\app.settings.json",
          "action": "write",
          "contents_ref": "app_settings"
        },
        {
          "path": "config\\world.schema.json",
          "action": "write",
          "contents_ref": "world_schema"
        }
      ]
    },
    {
      "name": "Write backend",
      "files": [
        {
          "path": "api\\gateway.py",
          "action": "write",
          "contents_ref": "api_gateway"
        },
        {
          "path": "src\\system.py",
          "action": "write",
          "contents_ref": "src_system"
        },
        {
          "path": "src\\utils\\hashing.py",
          "action": "write",
          "contents_ref": "src_hashing"
        },
        {
          "path": "src\\agents\\ledger_agent.py",
          "action": "write",
          "contents_ref": "src_ledger_agent"
        },
        {
          "path": "src\\payroll\\engine.py",
          "action": "write",
          "contents_ref": "src_payroll_engine"
        }
      ]
    },
    {
      "name": "Write web SPA (Vite + React)",
      "files": [
        {
          "path": "web\\package.json",
          "action": "write",
          "contents_ref": "web_package_json"
        },
        {
          "path": "web\\vite.config.js",
          "action": "write",
          "contents_ref": "web_vite_config"
        },
        {
          "path": "web\\index.html",
          "action": "write",
          "contents_ref": "web_index_html"
        },
        {
          "path": "web\\src\\main.jsx",
          "action": "write",
          "contents_ref": "web_main_jsx"
        },
        {
          "path": "web\\src\\App.jsx",
          "action": "write",
          "contents_ref": "web_app_jsx"
        },
        {
          "path": "web\\.env.development",
          "action": "write",
          "contents_ref": "web_env_dev"
        }
      ]
    },
    {
      "name": "Write mobile (Expo)",
      "files": [
        {
          "path": "app\\mobile\\package.json",
          "action": "write",
          "contents_ref": "mobile_package_json"
        },
        {
          "path": "app\\mobile\\App.js",
          "action": "write",
          "contents_ref": "mobile_app_js"
        }
      ]
    },
    {
      "name": "Write scripts",
      "files": [
        {
          "path": "scripts\\windows\\setup_python.bat",
          "action": "write",
          "contents_ref": "win_setup_python"
        },
        {
          "path": "scripts\\windows\\start_backend.bat",
          "action": "write",
          "contents_ref": "win_start_backend"
        },
        {
          "path": "scripts\\windows\\start_web.bat",
          "action": "write",
          "contents_ref": "win_start_web"
        },
        {
          "path": "scripts\\windows\\start_mobile.bat",
          "action": "write",
          "contents_ref": "win_start_mobile"
        }
      ]
    },
    {
      "name": "Write documentation",
      "files": [
        {
          "path": "README.md",
          "action": "write",
          "contents_ref": "readme_root"
        },
        {
          "path": "docs\\BLUEPRINT.md",
          "action": "write",
          "contents_ref": "doc_blueprint"
        },
        {
          "path": "docs\\ARCHITECTURE.md",
          "action": "write",
          "contents_ref": "doc_architecture"
        },
        {
          "path": "docs\\RUNBOOK_WINDOWS.md",
          "action": "write",
          "contents_ref": "doc_runbook"
        }
      ]
    },
    {
      "name": "Install Python deps & run backend",
      "shell": [
        "scripts\\windows\\setup_python.bat",
        "scripts\\windows\\start_backend.bat"
      ]
    },
    {
      "name": "Install web & run dev server",
      "shell": [
        "scripts\\windows\\start_web.bat"
      ]
    },
    {
      "name": "Install mobile & run Expo",
      "shell": [
        "scripts\\windows\\start_mobile.bat"
      ]
    },
    {
      "name": "Git init & push",
      "shell": [
        "git init",
        "git add .",
        "git commit -m \"feat: Whalez-AI world schema, payroll, API, web SPA, Expo app, scripts, docs\"",
        "git branch -M main",
        "git remote add origin https://github.com/AlphaWhalez/Whalez-AI.git",
        "git push -u origin main"
      ]
    }
  ],
  "contents": {
