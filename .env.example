FLASK_ENV=production
BIND_HOST=0.0.0.0
PORT=5050
CORS_ALLOW=*
SECRET_KEY=replace_me_in_local
EXTERNAL_URL=http://localhost:5050
# --- Stage 4 production knobs ---
SECRET_KEY=change_me_in_real_.env
LOG_LEVEL=INFO
TLS_CERT_PATH=
TLS_KEY_PATH=
