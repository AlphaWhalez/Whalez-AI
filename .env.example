SERVICE_PORT=5050
HEALTHCHECK_INTERVAL_SEC=20
HEALTHCHECK_RESTART_THRESHOLD=3
# Security vault defaults
VAULT_MASTER_KEY=change-me
TOKEN_SECRET=change-me
# Stage 5 orchestration
WEB_PORT=5173
PUBLIC_BASE_URL=http://localhost:5173
